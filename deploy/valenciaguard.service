[Unit]
Description=ValenciaGuard property management app
After=network.target

[Service]
Type=simple
User=valenciaguard
Group=valenciaguard
WorkingDirectory=/opt/valenciaguard
EnvironmentFile=/opt/valenciaguard/.env
# ROOT_PATH=/valenciaguard is read from the EnvironmentFile (.env)
ExecStart=/opt/valenciaguard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8473 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
