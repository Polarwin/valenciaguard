# --- Database ---
DATABASE_URL=sqlite:///./valenciaguard.db
# PostgreSQL later, e.g.: DATABASE_URL=postgresql+psycopg2://user:pass@localhost/valenciaguard

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- File storage ---
UPLOAD_DIR=uploads
# Deploy target: UPLOAD_DIR=/var/lib/valenciaguard/uploads

# --- Kimi AI (OpenAI-compatible) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# or https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2
# or moonshot-v1-8k

# --- SMTP (leave empty to log emails instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# --- PDF reports (Chinese) ---
# Path to a CJK TTF font, e.g. /usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc
CJK_FONT_PATH=

# --- Business rules ---
IRAV_RATE=0.0214
COST_THRESHOLD=200
